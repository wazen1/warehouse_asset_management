{
 "absolute_value": 0,
 "align_labels_right": 0,
 "creation": "2026-07-26 14:26:09.956612",
 "custom_format": 0,
 "default_print_language": "ar",
 "disabled": 0,
 "doc_type": "Fixed Asset Inventory",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap');\n\n    @page {\n        size: A4 portrait;\n        margin: 10mm 12mm 12mm 12mm;\n    }\n\n    * {\n        box-sizing: border-box;\n        -webkit-print-color-adjust: exact !important;\n        print-color-adjust: exact !important;\n    }\n\n    body {\n        font-family: 'Cairo', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n        direction: rtl;\n        text-align: right;\n        color: #1e293b;\n        background-color: #ffffff;\n        font-size: 11px;\n        line-height: 1.5;\n        margin: 0;\n        padding: 0;\n    }\n\n    /* Print Header */\n    .print-header {\n        display: flex;\n        justify-content: space-between;\n        align-items: center;\n        border-bottom: 3px solid #1e3a8a;\n        padding-bottom: 12px;\n        margin-bottom: 15px;\n    }\n\n    .company-brand h2 {\n        margin: 0;\n        font-size: 20px;\n        font-weight: 800;\n        color: #1e3a8a;\n    }\n\n    .company-brand p {\n        margin: 2px 0 0 0;\n        font-size: 11px;\n        color: #64748b;\n        font-weight: 600;\n    }\n\n    .doc-title-box {\n        text-align: center;\n    }\n\n    .doc-title-box h1 {\n        margin: 0;\n        font-size: 18px;\n        font-weight: 800;\n        color: #0f172a;\n        letter-spacing: -0.3px;\n    }\n\n    .doc-title-box .doc-subtitle {\n        display: inline-block;\n        background-color: #eff6ff;\n        color: #1d4ed8;\n        padding: 2px 10px;\n        border-radius: 4px;\n        font-size: 11px;\n        font-weight: 700;\n        margin-top: 4px;\n        border: 1px solid #bfdbfe;\n    }\n\n    .header-meta {\n        text-align: left;\n        font-size: 10px;\n        color: #475569;\n    }\n\n    .header-meta div {\n        margin-bottom: 2px;\n    }\n\n    .header-meta strong {\n        color: #0f172a;\n    }\n\n    /* Meta Details Grid */\n    .meta-grid {\n        display: grid;\n        grid-template-columns: repeat(4, 1fr);\n        gap: 8px;\n        margin-bottom: 15px;\n        background-color: #f8fafc;\n        border: 1px solid #e2e8f0;\n        border-radius: 8px;\n        padding: 10px 12px;\n    }\n\n    .meta-item {\n        display: flex;\n        flex-direction: column;\n    }\n\n    .meta-label {\n        font-size: 9px;\n        font-weight: 700;\n        color: #64748b;\n        text-transform: uppercase;\n    }\n\n    .meta-value {\n        font-size: 11px;\n        font-weight: 700;\n        color: #0f172a;\n        margin-top: 2px;\n    }\n\n    /* Statistics Dashboard Cards */\n    .stats-container {\n        display: grid;\n        grid-template-columns: repeat(4, 1fr);\n        gap: 10px;\n        margin-bottom: 18px;\n    }\n\n    .stat-card {\n        border-radius: 8px;\n        padding: 10px 12px;\n        border: 1px solid #e2e8f0;\n        position: relative;\n        overflow: hidden;\n    }\n\n    .stat-card .stat-title {\n        font-size: 10px;\n        font-weight: 700;\n        color: #475569;\n        margin-bottom: 4px;\n    }\n\n    .stat-card .stat-number {\n        font-size: 18px;\n        font-weight: 800;\n        line-height: 1.2;\n    }\n\n    .stat-card .stat-subtext {\n        font-size: 10px;\n        margin-top: 3px;\n        font-weight: 600;\n    }\n\n    .card-blue {\n        background-color: #eff6ff;\n        border-color: #bfdbfe;\n    }\n    .card-blue .stat-number { color: #1d4ed8; }\n    .card-blue .stat-subtext { color: #2563eb; }\n\n    .card-green {\n        background-color: #f0fdf4;\n        border-color: #bbf7d0;\n    }\n    .card-green .stat-number { color: #15803d; }\n    .card-green .stat-subtext { color: #16a34a; }\n\n    .card-red {\n        background-color: #fef2f2;\n        border-color: #fecaca;\n    }\n    .card-red .stat-number { color: #b91c1c; }\n    .card-red .stat-subtext { color: #dc2626; }\n\n    .card-amber {\n        background-color: #fffbeb;\n        border-color: #fde68a;\n    }\n    .card-amber .stat-number { color: #b45309; }\n    .card-amber .stat-subtext { color: #d97706; }\n\n    /* Section Title */\n    .section-header {\n        display: flex;\n        align-items: center;\n        justify-content: space-between;\n        border-bottom: 2px solid #0f172a;\n        padding-bottom: 4px;\n        margin-bottom: 10px;\n        margin-top: 15px;\n    }\n\n    .section-header h3 {\n        margin: 0;\n        font-size: 13px;\n        font-weight: 800;\n        color: #0f172a;\n    }\n\n    .section-header span {\n        font-size: 10px;\n        color: #64748b;\n        font-weight: 600;\n    }\n\n    /* Items Table */\n    .items-table {\n        width: 100%;\n        border-collapse: collapse;\n        margin-bottom: 15px;\n        font-size: 10px;\n    }\n\n    .items-table th {\n        background-color: #1e293b;\n        color: #ffffff;\n        padding: 7px 6px;\n        font-weight: 700;\n        text-align: center;\n        border: 1px solid #1e293b;\n        white-space: nowrap;\n    }\n\n    .items-table td {\n        padding: 6px 6px;\n        border: 1px solid #cbd5e1;\n        vertical-align: middle;\n    }\n\n    .items-table tbody tr:nth-child(even) {\n        background-color: #f8fafc;\n    }\n\n    .items-table td.text-center { text-align: center; }\n    .items-table td.text-left { text-align: left; }\n    .items-table td.text-right { text-align: right; }\n\n    /* Badges */\n    .badge {\n        display: inline-block;\n        padding: 2px 6px;\n        border-radius: 4px;\n        font-size: 9px;\n        font-weight: 700;\n        text-align: center;\n    }\n\n    .badge-found {\n        background-color: #dcfce7;\n        color: #15803d;\n        border: 1px solid #86efac;\n    }\n\n    .badge-missing {\n        background-color: #fee2e2;\n        color: #b91c1c;\n        border: 1px solid #fca5a5;\n    }\n\n    .badge-condition {\n        background-color: #f1f5f9;\n        color: #334155;\n        border: 1px solid #cbd5e1;\n    }\n\n    /* Financial Summary Bar */\n    .financial-summary {\n        background-color: #f8fafc;\n        border: 1px solid #cbd5e1;\n        border-radius: 6px;\n        padding: 10px 14px;\n        margin-bottom: 20px;\n        display: flex;\n        justify-content: space-between;\n        align-items: center;\n    }\n\n    .fin-item {\n        text-align: center;\n    }\n\n    .fin-item .fin-label {\n        font-size: 9px;\n        color: #64748b;\n        font-weight: 700;\n    }\n\n    .fin-item .fin-val {\n        font-size: 13px;\n        font-weight: 800;\n        color: #0f172a;\n        margin-top: 2px;\n    }\n\n    /* Committee Signatures */\n    .signatures-section {\n        margin-top: 25px;\n        page-break-inside: avoid;\n    }\n\n    .signatures-grid {\n        display: grid;\n        grid-template-columns: repeat(3, 1fr);\n        gap: 15px;\n        margin-top: 15px;\n    }\n\n    .sig-card {\n        border: 1px dashed #94a3b8;\n        border-radius: 6px;\n        padding: 10px;\n        text-align: center;\n        background-color: #fafafa;\n        min-height: 110px;\n        display: flex;\n        flex-direction: column;\n        justify-content: space-between;\n    }\n\n    .sig-title {\n        font-size: 10px;\n        font-weight: 700;\n        color: #334155;\n        border-bottom: 1px solid #e2e8f0;\n        padding-bottom: 4px;\n    }\n\n    .sig-space {\n        height: 45px;\n        display: flex;\n        align-items: center;\n        justify-content: center;\n    }\n\n    .sig-img {\n        max-height: 40px;\n        max-width: 120px;\n        object-fit: contain;\n    }\n\n    .sig-name {\n        font-size: 10px;\n        font-weight: 600;\n        color: #64748b;\n    }\n\n    /* Footer Notes */\n    .print-footer {\n        margin-top: 20px;\n        border-top: 1px solid #e2e8f0;\n        padding-top: 8px;\n        display: flex;\n        justify-content: space-between;\n        font-size: 9px;\n        color: #94a3b8;\n    }\n</style>\n\n<!-- Header -->\n<div class=\"print-header\">\n    <div class=\"company-brand\">\n        <h2>{{ doc.company }}</h2>\n        <p>\u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u0623\u0635\u0648\u0644 \u0627\u0644\u062b\u0627\u0628\u062a\u0629 \u0648\u0627\u0644\u0634\u0624\u0648\u0646 \u0627\u0644\u0625\u062f\u0627\u0631\u064a\u0629</p>\n    </div>\n    <div class=\"doc-title-box\">\n        <h1>\u0645\u062d\u0636\u0631 \u062c\u0631\u062f \u0627\u0644\u0623\u0635\u0648\u0644 \u0627\u0644\u062b\u0627\u0628\u062a\u0629</h1>\n        <div class=\"doc-subtitle\">{{ doc.name }}</div>\n    </div>\n    <div class=\"header-meta\">\n        <div>\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u062c\u0631\u062f: <strong>{{ frappe.utils.formatdate(doc.inventory_date) }}</strong></div>\n        <div>\u0633\u0646\u0629 \u0627\u0644\u062c\u0631\u062f: <strong>{{ doc.inventory_year or '' }}</strong></div>\n        <div>\u0627\u0644\u062d\u0627\u0644\u0629: <strong>\n            {% if doc.status == 'Completed' %}\u0645\u0643\u062a\u0645\u0644 \u0648\u0645\u0639\u062a\u0645\u062f{% elif doc.status == 'In Progress' %}\u0642\u064a\u062f \u0627\u0644\u0625\u062c\u0631\u0627\u0621{% elif doc.status == 'Draft' %}\u0645\u0633\u0648\u062f\u0629{% else %}{{ doc.status }}{% endif %}\n        </strong></div>\n    </div>\n</div>\n\n<!-- Scope Grid -->\n<div class=\"meta-grid\">\n    <div class=\"meta-item\">\n        <span class=\"meta-label\">\u0627\u0633\u0645 \u0627\u0644\u062c\u0631\u062f</span>\n        <span class=\"meta-value\">{{ doc.inventory_name }}</span>\n    </div>\n    <div class=\"meta-item\">\n        <span class=\"meta-label\">\u0646\u0648\u0639 \u0627\u0644\u062c\u0631\u062f</span>\n        <span class=\"meta-value\">\n            {% if doc.inventory_type in ['Full Inventory', '\u062c\u0631\u062f \u0634\u0627\u0645\u0644'] %}\u062c\u0631\u062f \u0634\u0627\u0645\u0644{% else %}\u062c\u0631\u062f \u062c\u0632\u0626\u064a / \u0641\u062d\u0635 \u0639\u0634\u0648\u0627\u0626\u064a{% endif %}\n        </span>\n    </div>\n    <div class=\"meta-item\">\n        <span class=\"meta-label\">\u0627\u0644\u0645\u0648\u0642\u0639 / \u0627\u0644\u0641\u0631\u0639</span>\n        <span class=\"meta-value\">{{ doc.location or '\u062c\u0645\u064a\u0639 \u0627\u0644\u0641\u0631\u0648\u0639 / \u063a\u064a\u0631 \u0645\u062d\u062f\u062f' }}</span>\n    </div>\n    <div class=\"meta-item\">\n        <span class=\"meta-label\">\u0627\u0644\u0642\u0633\u0645 / \u0627\u0644\u0625\u062f\u0627\u0631\u0629</span>\n        <span class=\"meta-value\">{{ doc.department or '\u062c\u0645\u064a\u0639 \u0627\u0644\u0623\u0642\u0633\u0627\u0645' }}</span>\n    </div>\n</div>\n\n<!-- KPI Dashboard Cards -->\n<div class=\"stats-container\">\n    <div class=\"stat-card card-blue\">\n        <div class=\"stat-title\">\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0623\u0635\u0648\u0644 \u0627\u0644\u0645\u062a\u0648\u0642\u0639\u0629</div>\n        <div class=\"stat-number\">{{ doc.expected_count or 0 }}</div>\n        <div class=\"stat-subtext\">\u0627\u0644\u0642\u064a\u0645\u0629: {{ frappe.format_value(doc.total_expected_value or 0, dict(fieldtype='Currency')) }}</div>\n    </div>\n    <div class=\"stat-card card-green\">\n        <div class=\"stat-title\">\u0627\u0644\u0623\u0635\u0648\u0644 \u0627\u0644\u0645\u0648\u062c\u0648\u062f\u0629 (\u0627\u0644\u0645\u0633\u062c\u0644\u0629)</div>\n        <div class=\"stat-number\">{{ doc.found_count or 0 }}</div>\n        <div class=\"stat-subtext\">\u0627\u0644\u0642\u064a\u0645\u0629: {{ frappe.format_value(doc.total_found_value or 0, dict(fieldtype='Currency')) }}</div>\n    </div>\n    <div class=\"stat-card card-red\">\n        <div class=\"stat-title\">\u0627\u0644\u0623\u0635\u0648\u0644 \u0627\u0644\u0645\u0641\u0642\u0648\u062f\u0629</div>\n        <div class=\"stat-number\">{{ doc.missing_count or 0 }}</div>\n        <div class=\"stat-subtext\">\u0627\u0644\u0642\u064a\u0645\u0629: {{ frappe.format_value(doc.total_missing_value or 0, dict(fieldtype='Currency')) }}</div>\n    </div>\n    <div class=\"stat-card card-amber\">\n        <div class=\"stat-title\">\u0646\u0633\u0628\u0629 \u0627\u0644\u0625\u0646\u062c\u0627\u0632 \u0627\u0644\u0641\u0639\u0644\u064a</div>\n        <div class=\"stat-number\">\n            {% if doc.expected_count and doc.expected_count > 0 %}\n                {{ ((doc.found_count or 0) / doc.expected_count * 100) | round(1) }}%\n            {% else %}\n                0%\n            {% endif %}\n        </div>\n        <div class=\"stat-subtext\">\u0627\u0644\u0645\u0633\u062d \u0627\u0644\u0636\u0648\u0626\u064a: {{ doc.scanned_count or 0 }} \u0623\u0635\u0644</div>\n    </div>\n</div>\n\n<!-- Financial Breakdown Bar -->\n<div class=\"financial-summary\">\n    <div class=\"fin-item\">\n        <div class=\"fin-label\">\u0627\u0644\u0642\u064a\u0645\u0629 \u0627\u0644\u062f\u0641\u062a\u0631\u064a\u0629 \u0627\u0644\u0643\u0644\u064a\u0629 \u0627\u0644\u0645\u062a\u0648\u0642\u0639\u0629</div>\n        <div class=\"fin-val\" style=\"color: #1d4ed8;\">{{ frappe.format_value(doc.total_expected_value or 0, dict(fieldtype='Currency')) }}</div>\n    </div>\n    <div style=\"border-right: 1px solid #cbd5e1; height: 25px;\"></div>\n    <div class=\"fin-item\">\n        <div class=\"fin-label\">\u0642\u064a\u0645\u0629 \u0627\u0644\u0623\u0635\u0648\u0644 \u0627\u0644\u0645\u0648\u062c\u0648\u062f\u0629 \u0628\u0627\u0644\u0645\u0648\u0642\u0639</div>\n        <div class=\"fin-val\" style=\"color: #15803d;\">{{ frappe.format_value(doc.total_found_value or 0, dict(fieldtype='Currency')) }}</div>\n    </div>\n    <div style=\"border-right: 1px solid #cbd5e1; height: 25px;\"></div>\n    <div class=\"fin-item\">\n        <div class=\"fin-label\">\u0642\u064a\u0645\u0629 \u0639\u062c\u0632 / \u0641\u0642\u062f\u0627\u0646 \u0627\u0644\u0623\u0635\u0648\u0644</div>\n        <div class=\"fin-val\" style=\"color: #b91c1c;\">{{ frappe.format_value(doc.total_missing_value or 0, dict(fieldtype='Currency')) }}</div>\n    </div>\n</div>\n\n<!-- Assets Table -->\n<div class=\"section-header\">\n    <h3>\u062c\u062f\u0648\u0644 \u062a\u0641\u0627\u0635\u064a\u0644 \u0648\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0623\u0635\u0648\u0644 \u0627\u0644\u062c\u0631\u062f\u064a\u0629 ({{ doc.items | length }} \u0623\u0635\u0644)</h3>\n    <span>\u0646\u062a\u064a\u062c\u0629 \u0627\u0644\u062c\u0631\u062f \u0627\u0644\u0646\u0647\u0627\u0626\u064a: {{ doc.inventory_result or '\u0642\u064a\u062f \u0627\u0644\u062a\u062f\u0642\u064a\u0642' }}</span>\n</div>\n\n{% if doc.items %}\n<table class=\"items-table\">\n    <thead>\n        <tr>\n            <th style=\"width: 4%;\">#</th>\n            <th style=\"width: 14%;\">\u0631\u0645\u0632 \u0627\u0644\u0623\u0635\u0644 (QR/ID)</th>\n            <th style=\"width: 24%;\">\u0627\u0633\u0645 \u0648\u0648\u0635\u0641 \u0627\u0644\u0623\u0635\u0644</th>\n            <th style=\"width: 13%;\">\u0627\u0644\u0645\u0648\u0642\u0639 \u0627\u0644\u0645\u0633\u062c\u0644</th>\n            <th style=\"width: 13%;\">\u0627\u0644\u0645\u0648\u0642\u0639 \u0627\u0644\u0641\u0639\u0644\u064a</th>\n            <th style=\"width: 10%;\">\u0627\u0644\u062d\u0627\u0644\u0629 \u0627\u0644\u0641\u0646\u064a\u0629</th>\n            <th style=\"width: 12%;\">\u0627\u0644\u0642\u064a\u0645\u0629 \u0627\u0644\u062f\u0641\u062a\u0631\u064a\u0629</th>\n            <th style=\"width: 10%;\">\u0646\u062a\u064a\u062c\u0629 \u0627\u0644\u062c\u0631\u062f</th>\n        </tr>\n    </thead>\n    <tbody>\n        {% for item in doc.items %}\n        <tr>\n            <td class=\"text-center\"><strong>{{ loop.index }}</strong></td>\n            <td class=\"text-center\" style=\"font-family: monospace; font-size: 10px; font-weight: 700;\">{{ item.asset }}</td>\n            <td>\n                <strong style=\"color: #0f172a;\">{{ item.asset_name }}</strong>\n                {% if item.department %}\n                    <br><span style=\"font-size: 8px; color: #64748b;\">\u0627\u0644\u0642\u0633\u0645: {{ item.department }}</span>\n                {% endif %}\n            </td>\n            <td class=\"text-center\">{{ item.location or '---' }}</td>\n            <td class=\"text-center\">\n                {% if item.actual_location %}\n                    <span style=\"{% if item.location != item.actual_location %}color: #d97706; font-weight: 700;{% endif %}\">\n                        {{ item.actual_location }}\n                    </span>\n                {% else %}\n                    {{ item.location or '---' }}\n                {% endif %}\n            </td>\n            <td class=\"text-center\">\n                <span class=\"badge badge-condition\">\n                    {% if item.condition == 'Good' %}\u062c\u064a\u062f\n                    {% elif item.condition == 'Excellent' %}\u0645\u0645\u062a\u0627\u0632\n                    {% elif item.condition == 'Fair' %}\u0645\u0642\u0628\u0648\u0644\n                    {% elif item.condition == 'Poor' %}\u0633\u064a\u0621\n                    {% elif item.condition == 'Damaged' %}\u062a\u0627\u0644\u0641\n                    {% elif item.condition == 'Missing' %}\u0645\u0641\u0642\u0648\u062f\n                    {% else %}{{ item.condition or '\u062c\u064a\u062f' }}{% endif %}\n                </span>\n            </td>\n            <td class=\"text-left\" style=\"font-weight: 700;\">\n                {{ frappe.format_value(item.current_book_value or 0, dict(fieldtype='Currency')) }}\n            </td>\n            <td class=\"text-center\">\n                {% if item.found %}\n                    <span class=\"badge badge-found\">\ud83d\udfe2 \u0645\u0648\u062c\u0648\u062f</span>\n                {% else %}\n                    <span class=\"badge badge-missing\">\ud83d\udd34 \u0645\u0641\u0642\u0648\u062f</span>\n                {% endif %}\n            </td>\n        </tr>\n        {% if item.notes %}\n        <tr>\n            <td colspan=\"8\" style=\"background-color: #fffbe8; font-size: 9px; padding: 3px 8px; color: #854d0e;\">\n                \ud83d\udccc <strong>\u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0627\u0644\u0623\u0635\u0644:</strong> {{ item.notes }}\n            </td>\n        </tr>\n        {% endif %}\n        {% endfor %}\n    </tbody>\n</table>\n{% else %}\n<div style=\"text-align: center; padding: 30px; color: #94a3b8; border: 1px dashed #cbd5e1; border-radius: 8px;\">\n    \u0644\u0627 \u062a\u0648\u062c\u062f \u0623\u0635\u0648\u0644 \u0645\u062f\u0631\u062c\u0629 \u0641\u064a \u0647\u0630\u0627 \u0627\u0644\u062a\u0642\u0631\u064a\u0631\n</div>\n{% endif %}\n\n{% if doc.remarks %}\n<div style=\"margin-top: 10px; background-color: #f8fafc; padding: 8px 12px; border-radius: 6px; border: 1px solid #e2e8f0;\">\n    <strong style=\"font-size: 10px; color: #475569;\">\u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0648\u062a\u0648\u0635\u064a\u0627\u062a \u0644\u062c\u0646\u0629 \u0627\u0644\u062c\u0631\u062f:</strong>\n    <p style=\"margin: 3px 0 0 0; font-size: 10px; color: #1e293b;\">{{ doc.remarks }}</p>\n</div>\n{% endif %}\n\n<!-- Signatures & Approval Section -->\n<div class=\"signatures-section\">\n    <div class=\"section-header\">\n        <h3>\u0627\u0639\u062a\u0645\u0627\u062f \u0648\u062a\u0648\u0642\u064a\u0639\u0627\u062a \u0644\u062c\u0646\u0629 \u0627\u0644\u062c\u0631\u062f \u0627\u0644\u0631\u0633\u0645\u064a\u0629</h3>\n        <span>\u064a\u0639\u062a\u0645\u062f \u0627\u0644\u0645\u062d\u0636\u0631 \u0631\u0633\u0645\u064a\u0627\u064b \u0628\u062a\u0648\u0642\u064a\u0639 \u0627\u0644\u0623\u0639\u0636\u0627\u0621</span>\n    </div>\n    <div class=\"signatures-grid\">\n        <div class=\"sig-card\">\n            <div class=\"sig-title\">\u0631\u0626\u064a\u0633 \u0644\u062c\u0646\u0629 \u0627\u0644\u062c\u0631\u062f</div>\n            <div class=\"sig-space\">\n                {% if doc.signature_committee_head %}\n                    <img src=\"{{ doc.signature_committee_head }}\" class=\"sig-img\" alt=\"\u062a\u0648\u0642\u064a\u0639 \u0631\u0626\u064a\u0633 \u0627\u0644\u0644\u062c\u0646\u0629\">\n                {% else %}\n                    <span style=\"font-size: 9px; color: #cbd5e1;\">(\u0627\u0644\u062a\u0648\u0642\u064a\u0639 \u0648\u0627\u0644\u062e\u062a\u0645)</span>\n                {% endif %}\n            </div>\n            <div class=\"sig-name\">{{ frappe.db.get_value(\"User\", doc.committee_head, \"full_name\") or doc.committee_head or '\u0627\u0633\u0645 \u0631\u0626\u064a\u0633 \u0627\u0644\u0644\u062c\u0646\u0629' }}</div>\n        </div>\n\n        <div class=\"sig-card\">\n            <div class=\"sig-title\">\u0623\u0645\u064a\u0646 \u0627\u0644\u0639\u0642\u062f\u0629 / \u0627\u0644\u0645\u0633\u0624\u0648\u0644 \u0627\u0644\u0645\u0628\u0627\u0634\u0631</div>\n            <div class=\"sig-space\">\n                <span style=\"font-size: 9px; color: #cbd5e1;\">(\u0627\u0644\u062a\u0648\u0642\u064a\u0639 \u0648\u0627\u0644\u062e\u062a\u0645)</span>\n            </div>\n            <div class=\"sig-name\">\u0627\u0633\u0645 \u0627\u0644\u0645\u0633\u0624\u0648\u0644 \u0627\u0644\u0645\u0628\u0627\u0634\u0631</div>\n        </div>\n\n        <div class=\"sig-card\">\n            <div class=\"sig-title\">\u0645\u062f\u064a\u0631 \u0642\u0633\u0645 \u0627\u0644\u0623\u0635\u0648\u0644 \u0627\u0644\u062b\u0627\u0628\u062a\u0629</div>\n            <div class=\"sig-space\">\n                {% if doc.signature_assets_manager %}\n                    <img src=\"{{ doc.signature_assets_manager }}\" class=\"sig-img\" alt=\"\u062a\u0648\u0642\u064a\u0639 \u0645\u062f\u064a\u0631 \u0627\u0644\u0623\u0635\u0648\u0644\">\n                {% else %}\n                    <span style=\"font-size: 9px; color: #cbd5e1;\">(\u0627\u0644\u062a\u0648\u0642\u064a\u0639 \u0648\u0627\u0644\u062e\u062a\u0645)</span>\n                {% endif %}\n            </div>\n            <div class=\"sig-name\">\u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u0623\u0635\u0648\u0644 \u0627\u0644\u062b\u0627\u0628\u062a\u0629 \u0648\u0627\u0644\u0645\u0627\u0644\u064a\u0629</div>\n        </div>\n    </div>\n</div>\n\n<!-- Print Footer -->\n<div class=\"print-footer\">\n    <div>\u0646\u0638\u0627\u0645 \u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u0623\u0635\u0648\u0644 \u0627\u0644\u062b\u0627\u0628\u062a\u0629 ERPNext - \u062a\u0645 \u0627\u0644\u0637\u0628\u0627\u0639\u0629 \u0628\u062a\u0627\u0631\u064a\u062e: {{ frappe.utils.now_datetime() }}</div>\n    <div>\u0635\u0641\u062d\u0629 1 \u0645\u0646 1</div>\n</div>\n",
