 "html": "<style>\n@page { size: A4 landscape; margin: 10mm 8mm; }\n* { box-sizing: border-box; }\n.pf-wrap { border:3px solid #7a5c00; border-radius:10px; overflow:hidden; font-family:\"Tahoma\",\"Cairo\",sans-serif; direction:rtl; color:#222; font-size:11px; }\n.pf-head { display:flex; justify-content:space-between; align-items:center; background:linear-gradient(135deg,#3a2e00,#7a5c00); color:#fff; padding:12px 18px; }\n.pf-head .logo { width:42px; height:42px; background:rgba(255,255,255,.12); border-radius:8px; display:flex; align-items:center; justify-content:center; font-size:22px; }\n.pf-head .bn { font-size:16px; font-weight:800; }\n.pf-head .bs { font-size:11px; opacity:.7; }\n.pf-head .meta { font-size:10.5px; opacity:.85; text-align:left; line-height:1.7; }\n.pf-title { text-align:center; font-size:16px; font-weight:800; margin:10px 0; color:#3a2e00; }\n.pf-kpi { display:flex; gap:8px; padding:0 12px 12px; }\n.pf-kpi div { flex:1; border:1px solid #d9cfa8; border-top:3px solid #7a5c00; border-radius:8px; padding:8px 10px; background:#fbf6e6; }\n.pf-kpi .l { font-size:10px; color:#8a7700; font-weight:700; }\n.pf-kpi .v { font-size:14px; font-weight:800; color:#3a2e00; }\ntable { width:100%; border-collapse:collapse; margin-top:4px; }\nth, td { border:1px solid #c9b878; padding:6px 8px; text-align:right; font-size:10.5px; }\nthead th { background:#3a2e00; color:#fff; font-weight:700; }\ntbody tr:nth-child(even) { background:#fbf6e6; }\n.num { text-align:left; font-variant-numeric:tabular-nums; white-space:nowrap; }\n.pf-foot { display:flex; justify-content:space-between; border-top:2px solid #7a5c00; margin-top:10px; padding:10px 6px; font-size:10px; color:#6b5e2e; }\n.sig { border-top:1px solid #7a5c00; margin-top:20px; padding-top:4px; text-align:center; color:#7a5c00; font-weight:700; min-width:160px; display:inline-block; }\n</style>\n\n<div class=\"pf-wrap\">\n  <div class=\"pf-head\">\n    <div style=\"display:flex;align-items:center;gap:12px\">\n      <div class=\"logo\">\ud83c\udfe6</div>\n      <div><div class=\"bn\">\u0627\u0644\u0645\u0635\u0631\u0641 \u0627\u0644\u0625\u0633\u0644\u0627\u0645\u064a \u0627\u0644\u0644\u064a\u0628\u064a</div><div class=\"bs\">\u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u0623\u0635\u0648\u0644 \u0627\u0644\u062b\u0627\u0628\u062a\u0629 \u00b7 \u062c\u062f\u0648\u0644 \u0627\u0644\u0625\u0647\u0644\u0627\u0643</div></div>\n    </div>\n    <div class=\"meta\">\u0631\u0642\u0645 \u0627\u0644\u062c\u062f\u0648\u0644: {{ doc.name }}<br>\u0627\u0644\u0623\u0635\u0644: {{ doc.asset or \"\u2014\" }}<br>\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0637\u0628\u0627\u0639\u0629: {{ doc.get_formatted(\"creation\") or \"\" }}</div>\n  </div>\n\n  <div class=\"pf-title\">\u062c\u062f\u0648\u0644 \u0625\u0647\u0644\u0627\u0643 \u0627\u0644\u0623\u0635\u0644 \u0627\u0644\u062b\u0627\u0628\u062a</div>\n\n  <div class=\"pf-kpi\">\n    <div><div class=\"l\">\u0646\u0648\u0639 \u0627\u0644\u0633\u064a\u0627\u0631\u0629</div><div class=\"v\">{{ doc.vehicle_type_ref or doc.asset or \"\u2014\" }}</div></div>\n    <div><div class=\"l\">\u0631\u0642\u0645 \u0627\u0644\u0644\u0648\u062d\u0629</div><div class=\"v\" style=\"color:#7a5c00\">{{ doc.plate_number_ads or \"\u2014\" }}</div></div>\n    <div><div class=\"l\">\u0627\u0644\u0644\u0648\u0646</div><div class=\"v\">{{ doc.vehicle_color_ads or \"\u2014\" }}</div></div>\n    <div><div class=\"l\">\u0633\u0646\u0629 \u0627\u0644\u0635\u0646\u0639</div><div class=\"v\">{{ doc.manufacture_year_ads or \"\u2014\" }}</div></div>\n    <div><div class=\"l\">\u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u0625\u0647\u0644\u0627\u0643</div><div class=\"v\">{{ doc.depreciation_method or \"\u2014\" }}</div></div>\n  </div>\n\n  <table>\n    <thead>\n      <tr>\n        <th style=\"width:30px\">#</th>\n        <th>\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0642\u0633\u0637</th>\n        <th class=\"num\">\u0645\u0628\u0644\u063a \u0627\u0644\u0625\u0647\u0644\u0627\u0643</th>\n        <th class=\"num\">\u0627\u0644\u0625\u0647\u0644\u0627\u0643 \u0627\u0644\u0645\u062a\u0631\u0627\u0643\u0645</th>\n        <th>\u0642\u064a\u062f \u0627\u0644\u064a\u0648\u0645\u064a\u0629</th>\n      </tr>\n    </thead>\n    <tbody>\n      {% for d in doc.depreciation_schedule %}\n      <tr>\n        <td style=\"text-align:center\">{{ loop.index }}</td>\n        <td>{{ d.schedule_date or \"\u2014\" }}</td>\n        <td class=\"num\">{{ \"%.2f\"|format(d.depreciation_amount or 0) }}</td>\n        <td class=\"num\">{{ \"%.2f\"|format(d.accumulated_depreciation_amount or 0) }}</td>\n        <td>{{ d.journal_entry or \"\u2014\" }}</td>\n      </tr>\n      {% endfor %}\n    </tbody>\n  </table>\n\n  <div class=\"pf-foot\">\n    <div>\u062a\u0645 \u0625\u0646\u0634\u0627\u0621 \u0647\u0630\u0627 \u0627\u0644\u062a\u0642\u0631\u064a\u0631 \u0622\u0644\u064a\u0627\u064b \u0645\u0646 \u0646\u0638\u0627\u0645 \u0627\u0644\u0645\u0635\u0631\u0641 \u0627\u0644\u0625\u0633\u0644\u0627\u0645\u064a \u0627\u0644\u0644\u064a\u0628\u064a</div>\n    <div class=\"sig\">\u0631\u0626\u064a\u0633 \u0642\u0633\u0645 \u0627\u0644\u0623\u0635\u0648\u0644 \u0627\u0644\u062b\u0627\u0628\u062a\u0629</div>\n  </div>\n</div>\n",
