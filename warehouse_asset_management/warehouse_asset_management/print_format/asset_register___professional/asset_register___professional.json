{
 "absolute_value": 0,
 "align_labels_right": 0,
 "creation": "2026-08-12 07:44:52",
 "custom_format": 0,
 "disabled": 0,
 "doc_type": "Asset",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<style>\n@import url(\"https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&family=Inter:wght@400;600;700;800&display=swap\");\n\n@page {\n    size: A4 portrait;\n    margin: 15mm 12mm;\n}\n\n* { box-sizing: border-box; margin: 0; padding: 0; }\n\n.asset-print {\n    font-family: \"Cairo\", \"Inter\", sans-serif;\n    direction: rtl;\n    color: #1e293b;\n    font-size: 11px;\n    line-height: 1.5;\n}\n\n/* \u2500\u2500 Header \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n.report-header {\n    text-align: center;\n    margin-bottom: 18px;\n    padding-bottom: 14px;\n    border-bottom: 4px double #0f172a;\n    position: relative;\n}\n\n.report-header::after {\n    content: \"\";\n    position: absolute;\n    bottom: -2px;\n    left: 20%;\n    right: 20%;\n    height: 1px;\n    background: #cbd5e1;\n}\n\n.report-header h1 {\n    font-size: 24px;\n    font-weight: 800;\n    color: #0f172a;\n    margin: 0 0 4px 0;\n    letter-spacing: 1px;\n}\n\n.company-name {\n    font-size: 14px;\n    font-weight: 700;\n    color: #1e40af;\n    margin-bottom: 2px;\n}\n\n.report-date {\n    font-size: 10px;\n    color: #64748b;\n}\n\n/* \u2500\u2500 Asset Identity Banner \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n.identity-banner {\n    background: linear-gradient(135deg, #0f172a 0%, #1e3a5f 100%);\n    color: #ffffff;\n    padding: 12px 16px;\n    border-radius: 8px;\n    margin-bottom: 14px;\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n}\n\n.identity-banner .asset-id {\n    font-family: \"Courier New\", monospace;\n    font-size: 18px;\n    font-weight: 800;\n    letter-spacing: 2px;\n}\n\n.identity-banner .asset-name-display {\n    font-size: 16px;\n    font-weight: 700;\n}\n\n.identity-banner .status-badge {\n    background: #22c55e;\n    color: #fff;\n    padding: 4px 14px;\n    border-radius: 20px;\n    font-size: 11px;\n    font-weight: 700;\n}\n\n/* \u2500\u2500 Section Boxes \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n.section-box {\n    border: 1px solid #e2e8f0;\n    border-radius: 8px;\n    margin-bottom: 12px;\n    overflow: hidden;\n}\n\n.section-title {\n    background: linear-gradient(135deg, #1e3a5f, #2563eb);\n    color: #ffffff;\n    padding: 8px 14px;\n    font-size: 13px;\n    font-weight: 700;\n    display: flex;\n    align-items: center;\n    gap: 8px;\n}\n\n.section-title .icon {\n    font-size: 16px;\n}\n\n.section-content {\n    padding: 10px 14px;\n}\n\n/* \u2500\u2500 Info Grid \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n.info-grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 6px 20px;\n}\n\n.info-item {\n    display: flex;\n    align-items: baseline;\n    padding: 4px 0;\n    border-bottom: 1px dotted #e2e8f0;\n}\n\n.info-item:last-child {\n    border-bottom: none;\n}\n\n.info-label {\n    font-weight: 700;\n    color: #475569;\n    min-width: 120px;\n    flex-shrink: 0;\n}\n\n.info-sep {\n    color: #2563eb;\n    font-weight: 700;\n    margin: 0 4px;\n}\n\n.info-value {\n    font-weight: 600;\n    color: #0f172a;\n}\n\n.info-value.money {\n    font-family: \"Courier New\", monospace;\n    color: #1e40af;\n    font-weight: 800;\n}\n\n/* \u2500\u2500 Depreciation Table \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n.depr-table {\n    width: 100%;\n    border-collapse: collapse;\n    font-size: 10px;\n    margin-top: 6px;\n}\n\n.depr-table th {\n    background: #1e3a5f;\n    color: #ffffff;\n    padding: 6px 8px;\n    text-align: right;\n    font-weight: 700;\n    border: 1px solid #1e3a5f;\n}\n\n.depr-table td {\n    padding: 5px 8px;\n    border: 1px solid #e2e8f0;\n    text-align: right;\n}\n\n.depr-table tr:nth-child(even) {\n    background-color: #f8fafc;\n}\n\n.depr-summary {\n    display: flex;\n    justify-content: space-around;\n    margin-top: 10px;\n    gap: 10px;\n}\n\n.summary-card {\n    flex: 1;\n    text-align: center;\n    padding: 10px;\n    border: 1px solid #e2e8f0;\n    border-radius: 8px;\n    background: #f8fafc;\n}\n\n.summary-card .card-label {\n    font-size: 10px;\n    color: #64748b;\n    font-weight: 600;\n}\n\n.summary-card .card-value {\n    font-family: \"Courier New\", monospace;\n    font-size: 16px;\n    font-weight: 800;\n    color: #1e40af;\n    margin-top: 4px;\n}\n\n/* \u2500\u2500 Footer \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n.report-footer {\n    margin-top: 20px;\n    padding-top: 10px;\n    border-top: 2px solid #0f172a;\n    display: flex;\n    justify-content: space-between;\n    font-size: 10px;\n    color: #64748b;\n}\n\n.signatures {\n    display: flex;\n    justify-content: space-around;\n    margin-top: 30px;\n    padding: 0 20px;\n}\n\n.sig-box {\n    text-align: center;\n    width: 160px;\n}\n\n.sig-line {\n    border-top: 2px solid #0f172a;\n    padding-top: 8px;\n    font-size: 11px;\n    font-weight: 700;\n    color: #475569;\n}\n\n/* \u2500\u2500 Print \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\n@media print {\n    .asset-print { font-size: 10px; }\n    .section-box { break-inside: avoid; }\n    .identity-banner { -webkit-print-color-adjust: exact; print-color-adjust: exact; }\n    .section-title { -webkit-print-color-adjust: exact; print-color-adjust: exact; }\n}\n</style>\n\n<div class=\"asset-print\">\n    <!-- \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 Header \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 -->\n    <div class=\"report-header\">\n        <h1>\u0628\u0637\u0627\u0642\u0629 \u0623\u0635\u0644 \u062b\u0627\u0628\u062a</h1>\n        <div class=\"company-name\">{{ frappe.db.get_value(\"Company\", doc.company, \"company_name\") or doc.company }}</div>\n        <div class=\"report-date\">\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0637\u0628\u0627\u0639\u0629: {{ frappe.utils.formatdate(frappe.utils.nowdate()) }} | {{ frappe.utils.now_datetime().strftime(\"%H:%M\") }}</div>\n    </div>\n\n    <!-- \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 Identity Banner \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 -->\n    <div class=\"identity-banner\">\n        <div>\n            <div class=\"asset-id\">{{ doc.name }}</div>\n            <div class=\"asset-name-display\">{{ doc.asset_name }}</div>\n        </div>\n        <div>\n            <span class=\"status-badge\">{{ doc.status }}</span>\n        </div>\n    </div>\n\n    <!-- \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 Basic Info \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 -->\n    <div class=\"section-box\">\n        <div class=\"section-title\">\n            <span class=\"icon\">\ud83d\udccb</span> \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0623\u0633\u0627\u0633\u064a\u0629\n        </div>\n        <div class=\"section-content\">\n            <div class=\"info-grid\">\n                <div class=\"info-item\">\n                    <span class=\"info-label\">\u0627\u0633\u0645 \u0627\u0644\u0623\u0635\u0644</span>\n                    <span class=\"info-sep\">:</span>\n                    <span class=\"info-value\">{{ doc.asset_name }}</span>\n                </div>\n                <div class=\"info-item\">\n                    <span class=\"info-label\">\u0631\u0642\u0645 \u0627\u0644\u0623\u0635\u0644</span>\n                    <span class=\"info-sep\">:</span>\n                    <span class=\"info-value\" style=\"font-family: monospace;\">{{ doc.name }}</span>\n                </div>\n                <div class=\"info-item\">\n                    <span class=\"info-label\">\u0641\u0626\u0629 \u0627\u0644\u0623\u0635\u0644</span>\n                    <span class=\"info-sep\">:</span>\n                    <span class=\"info-value\">{{ doc.asset_category or \"\u2014\" }}</span>\n                </div>\n                <div class=\"info-item\">\n                    <span class=\"info-label\">\u0646\u0648\u0639 \u0627\u0644\u0623\u0635\u0644</span>\n                    <span class=\"info-sep\">:</span>\n                    <span class=\"info-value\">{{ doc.asset_type or \"\u2014\" }}</span>\n                </div>\n                <div class=\"info-item\">\n                    <span class=\"info-label\">\u0627\u0644\u0645\u0648\u0642\u0639</span>\n                    <span class=\"info-sep\">:</span>\n                    <span class=\"info-value\">{{ doc.location or \"\u2014\" }}</span>\n                </div>\n                <div class=\"info-item\">\n                    <span class=\"info-label\">\u0627\u0644\u0642\u0633\u0645</span>\n                    <span class=\"info-sep\">:</span>\n                    <span class=\"info-value\">{{ doc.department or \"\u2014\" }}</span>\n                </div>\n                <div class=\"info-item\">\n                    <span class=\"info-label\">\u0645\u0631\u0643\u0632 \u0627\u0644\u062a\u0643\u0644\u0641\u0629</span>\n                    <span class=\"info-sep\">:</span>\n                    <span class=\"info-value\">{{ doc.cost_center or \"\u2014\" }}</span>\n                </div>\n                <div class=\"info-item\">\n                    <span class=\"info-label\">\u0627\u0644\u062d\u0627\u0644\u0629</span>\n                    <span class=\"info-sep\">:</span>\n                    <span class=\"info-value\">{{ doc.status }}</span>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <!-- \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 Purchase Info \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 -->\n    <div class=\"section-box\">\n        <div class=\"section-title\">\n            <span class=\"icon\">\ud83d\udcb0</span> \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0634\u0631\u0627\u0621\n        </div>\n        <div class=\"section-content\">\n            <div class=\"info-grid\">\n                <div class=\"info-item\">\n                    <span class=\"info-label\">\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0634\u0631\u0627\u0621</span>\n                    <span class=\"info-sep\">:</span>\n                    <span class=\"info-value\">{{ frappe.utils.formatdate(doc.purchase_date) if doc.purchase_date else \"\u2014\" }}</span>\n                </div>\n                <div class=\"info-item\">\n                    <span class=\"info-label\">\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645</span>\n                    <span class=\"info-sep\">:</span>\n                    <span class=\"info-value\">{{ frappe.utils.formatdate(doc.available_for_use_date) if doc.available_for_use_date else \"\u2014\" }}</span>\n                </div>\n                <div class=\"info-item\">\n                    <span class=\"info-label\">\u0645\u0628\u0644\u063a \u0627\u0644\u0634\u0631\u0627\u0621</span>\n                    <span class=\"info-sep\">:</span>\n                    <span class=\"info-value money\">{{ frappe.utils.fmt_money(doc.gross_purchase_amount, currency=\"JOD\") }}</span>\n                </div>\n                <div class=\"info-item\">\n                    <span class=\"info-label\">\u0627\u0644\u062a\u0643\u0644\u0641\u0629 \u0627\u0644\u0625\u0636\u0627\u0641\u064a\u0629</span>\n                    <span class=\"info-sep\">:</span>\n                    <span class=\"info-value money\">{{ frappe.utils.fmt_money(doc.additional_asset_cost or 0, currency=\"JOD\") }}</span>\n                </div>\n                <div class=\"info-item\">\n                    <span class=\"info-label\">\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u062a\u0643\u0644\u0641\u0629</span>\n                    <span class=\"info-sep\">:</span>\n                    <span class=\"info-value money\">{{ frappe.utils.fmt_money(doc.total_asset_cost or doc.gross_purchase_amount, currency=\"JOD\") }}</span>\n                </div>\n                <div class=\"info-item\">\n                    <span class=\"info-label\">\u0643\u0645\u064a\u0629 \u0627\u0644\u0623\u0635\u0644</span>\n                    <span class=\"info-sep\">:</span>\n                    <span class=\"info-value\">{{ doc.asset_quantity or 1 }}</span>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <!-- \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 Depreciation Info \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 -->\n    {% if doc.calculate_depreciation %}\n    <div class=\"section-box\">\n        <div class=\"section-title\">\n            <span class=\"icon\">\ud83d\udcc9</span> \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0625\u0647\u0644\u0627\u0643\n        </div>\n        <div class=\"section-content\">\n            <div class=\"info-grid\">\n                <div class=\"info-item\">\n                    <span class=\"info-label\">\u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u0625\u0647\u0644\u0627\u0643</span>\n                    <span class=\"info-sep\">:</span>\n                    <span class=\"info-value\">{{ doc.depreciation_method or \"\u2014\" }}</span>\n                </div>\n                <div class=\"info-item\">\n                    <span class=\"info-label\">\u0627\u0644\u0642\u064a\u0645\u0629 \u0628\u0639\u062f \u0627\u0644\u0625\u0647\u0644\u0627\u0643</span>\n                    <span class=\"info-sep\">:</span>\n                    <span class=\"info-value money\">{{ frappe.utils.fmt_money(doc.value_after_depreciation or 0, currency=\"JOD\") }}</span>\n                </div>\n                <div class=\"info-item\">\n                    <span class=\"info-label\">\u0639\u062f\u062f \u0627\u0644\u0625\u0647\u0644\u0627\u0643\u0627\u062a</span>\n                    <span class=\"info-sep\">:</span>\n                    <span class=\"info-value\">{{ doc.total_number_of_depreciations or \"\u2014\" }}</span>\n                </div>\n                <div class=\"info-item\">\n                    <span class=\"info-label\">\u062f\u0648\u0631\u064a\u0629 \u0627\u0644\u0625\u0647\u0644\u0627\u0643</span>\n                    <span class=\"info-sep\">:</span>\n                    <span class=\"info-value\">{{ doc.frequency_of_depreciation or \"\u2014\" }} \u0634\u0647\u0631</span>\n                </div>\n                <div class=\"info-item\">\n                    <span class=\"info-label\">\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0625\u0647\u0644\u0627\u0643 \u0627\u0644\u062a\u0627\u0644\u064a</span>\n                    <span class=\"info-sep\">:</span>\n                    <span class=\"info-value\">{{ frappe.utils.formatdate(doc.next_depreciation_date) if doc.next_depreciation_date else \"\u2014\" }}</span>\n                </div>\n                <div class=\"info-item\">\n                    <span class=\"info-label\">\u0627\u0644\u0625\u0647\u0644\u0627\u0643 \u0627\u0644\u0645\u062a\u0631\u0627\u0643\u0645 \u0627\u0644\u0627\u0641\u062a\u062a\u0627\u062d\u064a</span>\n                    <span class=\"info-sep\">:</span>\n                    <span class=\"info-value money\">{{ frappe.utils.fmt_money(doc.opening_accumulated_depreciation or 0, currency=\"JOD\") }}</span>\n                </div>\n            </div>\n\n            {% if doc.finance_books and doc.finance_books|length > 0 %}\n            <div style=\"margin-top: 10px; border-top: 1px dashed #e2e8f0; padding-top: 8px;\">\n                <strong style=\"color: #475569;\">\u062f\u0641\u062a\u0631 \u0627\u0644\u0645\u0627\u0644\u064a\u0629:</strong>\n                {% for fb in doc.finance_books %}\n                <div style=\"margin-top: 6px; padding: 8px; background: #f8fafc; border-radius: 6px; border: 1px solid #e2e8f0;\">\n                    <div style=\"display: flex; gap: 20px; flex-wrap: wrap;\">\n                        <span><strong>\u062f\u0641\u062a\u0631 \u0627\u0644\u0645\u0627\u0644\u064a\u0629:</strong> {{ fb.finance_book or \"\u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a\" }}</span>\n                        <span><strong>\u0627\u0644\u0625\u0647\u0644\u0627\u0643 \u0627\u0644\u0645\u062a\u0631\u0627\u0643\u0645:</strong> {{ frappe.utils.fmt_money(fb.accumulated_depreciation_amount or 0, currency=\"JOD\") }}</span>\n                        <span><strong>\u0627\u0644\u0642\u064a\u0645\u0629 \u0627\u0644\u062d\u0627\u0644\u064a\u0629:</strong> {{ frappe.utils.fmt_money(fb.value_after_depreciation or 0, currency=\"JOD\") }}</span>\n                        <span><strong>\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0625\u0647\u0644\u0627\u0643 \u0627\u0644\u062a\u0627\u0644\u064a:</strong> {{ frappe.utils.formatdate(fb.next_depreciation_date) if fb.next_depreciation_date else \"\u2014\" }}</span>\n                    </div>\n                </div>\n                {% endfor %}\n            </div>\n            {% endif %}\n        </div>\n    </div>\n    {% endif %}\n\n    <!-- \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 Ownership \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 -->\n    <div class=\"section-box\">\n        <div class=\"section-title\">\n            <span class=\"icon\">\ud83c\udfe2</span> \u0627\u0644\u0645\u0644\u0643\u064a\u0629 \u0648\u0627\u0644 possession\n        </div>\n        <div class=\"section-content\">\n            <div class=\"info-grid\">\n                <div class=\"info-item\">\n                    <span class=\"info-label\">\u0645\u0627\u0644\u0643 \u0627\u0644\u0623\u0635\u0644</span>\n                    <span class=\"info-sep\">:</span>\n                    <span class=\"info-value\">{{ doc.asset_owner or \"\u2014\" }}</span>\n                </div>\n                <div class=\"info-item\">\n                    <span class=\"info-label\">\u0634\u0631\u0643\u0629 \u0627\u0644\u0645\u0627\u0644\u0643</span>\n                    <span class=\"info-sep\">:</span>\n                    <span class=\"info-value\">{{ doc.asset_owner_company or \"\u2014\" }}</span>\n                </div>\n                <div class=\"info-item\">\n                    <span class=\"info-label\">\u0627\u0644\u0645\u064f\u0633\u062ahold</span>\n                    <span class=\"info-sep\">:</span>\n                    <span class=\"info-value\">{{ doc.custodian or \"\u2014\" }}</span>\n                </div>\n                <div class=\"info-item\">\n                    <span class=\"info-label\">\u0627\u0644\u0639\u0645\u064a\u0644</span>\n                    <span class=\"info-sep\">:</span>\n                    <span class=\"info-value\">{{ doc.customer or \"\u2014\" }}</span>\n                </div>\n                <div class=\"info-item\">\n                    <span class=\"info-label\">\u0627\u0644\u0645\u0648\u0631\u062f</span>\n                    <span class=\"info-sep\">:</span>\n                    <span class=\"info-value\">{{ doc.supplier or \"\u2014\" }}</span>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <!-- \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 Insurance \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 -->\n    {% if doc.policy_number or doc.insurer %}\n    <div class=\"section-box\">\n        <div class=\"section-title\">\n            <span class=\"icon\">\ud83d\udee1\ufe0f</span> \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u062a\u0623\u0645\u064a\u0646\n        </div>\n        <div class=\"section-content\">\n            <div class=\"info-grid\">\n                <div class=\"info-item\">\n                    <span class=\"info-label\">\u0631\u0642\u0645 \u0627\u0644\u0628\u0648\u0644\u064a\u0635\u0629</span>\n                    <span class=\"info-sep\">:</span>\n                    <span class=\"info-value\">{{ doc.policy_number or \"\u2014\" }}</span>\n                </div>\n                <div class=\"info-item\">\n                    <span class=\"info-label\">\u0634\u0631\u0643\u0629 \u0627\u0644\u062a\u0623\u0645\u064a\u0646</span>\n                    <span class=\"info-sep\">:</span>\n                    <span class=\"info-value\">{{ doc.insurer or \"\u2014\" }}</span>\n                </div>\n                <div class=\"info-item\">\n                    <span class=\"info-label\">\u0627\u0644\u0642\u064a\u0645\u0629 \u0627\u0644\u0645\u0624\u0645\u064e\u0651\u0646\u0629</span>\n                    <span class=\"info-sep\">:</span>\n                    <span class=\"info-value money\">{{ frappe.utils.fmt_money(doc.insured_value or 0, currency=\"JOD\") }}</span>\n                </div>\n                <div class=\"info-item\">\n                    <span class=\"info-label\">\u0641\u062a\u0631\u0629 \u0627\u0644\u062a\u0623\u0645\u064a\u0646</span>\n                    <span class=\"info-sep\">:</span>\n                    <span class=\"info-value\">{{ frappe.utils.formatdate(doc.insurance_start_date) if doc.insurance_start_date else \"\u2014\" }} \u0625\u0644\u0649 {{ frappe.utils.formatdate(doc.insurance_end_date) if doc.insurance_end_date else \"\u2014\" }}</span>\n                </div>\n            </div>\n        </div>\n    </div>\n    {% endif %}\n\n    <!-- \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 Summary Cards \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 -->\n    <div class=\"depr-summary\">\n        <div class=\"summary-card\">\n            <div class=\"card-label\">\u0627\u0644\u062a\u0643\u0644\u0641\u0629 \u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a\u0629</div>\n            <div class=\"card-value\">{{ frappe.utils.fmt_money(doc.gross_purchase_amount, currency=\"JOD\") }}</div>\n        </div>\n        <div class=\"summary-card\">\n            <div class=\"card-label\">\u0627\u0644\u0625\u0647\u0644\u0627\u0643 \u0627\u0644\u0645\u062a\u0631\u0627\u0643\u0645</div>\n            <div class=\"card-value\">{{ frappe.utils.fmt_money(doc.opening_accumulated_depreciation or 0, currency=\"JOD\") }}</div>\n        </div>\n        <div class=\"summary-card\">\n            <div class=\"card-label\">\u0627\u0644\u0642\u064a\u0645\u0629 \u0627\u0644\u062f\u0641\u062a\u0631\u064a\u0629</div>\n            <div class=\"card-value\">{{ frappe.utils.fmt_money(doc.value_after_depreciation or doc.gross_purchase_amount, currency=\"JOD\") }}</div>\n        </div>\n    </div>\n\n    <!-- \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 Footer \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 -->\n    <div class=\"report-footer\">\n        <span>\u0631\u0642\u0645 \u0627\u0644\u062a\u0642\u0631\u064a\u0631: {{ doc.name }}</span>\n        <span>\u0646\u0638\u0627\u0645 \u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u0623\u0635\u0648\u0644 - Lib</span>\n        <span>\u0635\u0641\u062d\u0629 1 \u0645\u0646 1</span>\n    </div>\n\n    <!-- \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 Signatures \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 -->\n    <div class=\"signatures\">\n        <div class=\"sig-box\">\n            <div class=\"sig-line\">\u0625\u0639\u062f\u0627\u062f: _______________</div>\n        </div>\n        <div class=\"sig-box\">\n            <div class=\"sig-line\">\u0645\u0631\u0627\u062c\u0639\u0629: _______________</div>\n        </div>\n        <div class=\"sig-box\">\n            <div class=\"sig-line\">\u0627\u0639\u062a\u0645\u0627\u062f: _______________</div>\n        </div>\n    </div>\n</div>",
